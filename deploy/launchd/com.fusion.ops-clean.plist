<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
        <key>Label</key>
        <string>com.fusion.ops-clean</string>
        <key>Comment</key>
        <string>Fusion ops cleanup pass on the workspace (issue #15). DSN comes from ~/.fusion-ops/env so deletions are audited into cleanup_audit; policy at ~/.fusion-ops/clean-config.json.</string>
        <key>ProgramArguments</key>
        <array>
                <string>/Users/dahai/.fusion-ops/bin/run-clean.sh</string>
        </array>
        <key>StartCalendarInterval</key>
        <dict>
                <key>Hour</key>
                <integer>10</integer>
                <key>Minute</key>
                <integer>0</integer>
        </dict>
        <key>StandardOutPath</key>
        <string>/Users/dahai/.fusion-ops/logs/clean.log</string>
        <key>StandardErrorPath</key>
        <string>/Users/dahai/.fusion-ops/logs/clean.log</string>
</dict>
</plist>
